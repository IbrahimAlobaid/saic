---
import { t, href, type Locale } from '../i18n';
import { visibleNav } from '../lib/nav';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const items = await visibleNav(locale);
---

<footer>
  <div class="wrap">
    <p class="motto">{d.footer.motto}</p>
    <p class="ftag">{d.footer.tag}</p>
    <ul class="fnav">
      {items.map((item) => <li><a href={href(locale, item.path)}>{item.label}</a></li>)}
    </ul>
    <p class="copy">{d.footer.copy}</p>
  </div>
</footer>
