---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import mark from '../../assets/mark.png';
import Follow from '../Follow.astro';
import EventCard from '../EventCard.astro';
import ProjectCard from '../ProjectCard.astro';
import PersonCard from '../PersonCard.astro';
import Faq from '../Faq.astro';
import { t, href, type Locale } from '../../i18n';
import { splitEvents, allProjects, activePeople, groupTeam, tx, initial } from '../../lib/content';
import { buildFaq } from '../../lib/faq';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const tracks = [...d.about.how.tracks, d.about.how.fifth];
const campPath = '/programs/ai-engineering-camp/';
const { upcoming } = await splitEvents();
const nextEvents = upcoming.slice(0, 3);
const projects = await allProjects();
const featured = [...projects.filter((p) => p.data.featured), ...projects.filter((p) => !p.data.featured)].slice(0, 3);
const { founders, trainers } = groupTeam(await activePeople());
const hasTeam = founders.length + trainers.length > 0;

/* The home page shows a short selection; the full list (and its FAQPage markup) lives on /faq/. */
const homeFaqIds = ['what', 'founders', 'trainers', 'who', 'join'];
const faq = (await buildFaq(locale, d.faq.general, Astro.site)).filter((it) => homeFaqIds.includes(it.id));

/* Section numbers follow the sections that are actually on the page. */
const order = [
  'about',
  ...(nextEvents.length ? ['events'] : []),
  ...(featured.length ? ['projects'] : []),
  'offer',
  'program',
  ...(hasTeam ? ['team'] : []),
  ...(faq.length ? ['faq'] : []),
];
const fmt = new Intl.NumberFormat(locale === 'ar' ? 'ar-SY' : 'en-GB', { minimumIntegerDigits: 2 });
const num = (key: string) => fmt.format(order.indexOf(key) + 1);
---

<section class="hero">
  <Image class="wm" src={mark} alt="" width={960} format="webp" loading="lazy" decoding="async" fetchpriority="low" aria-hidden="true" />
  <div class="wrap">
    <Image
      class="logo"
      src={logo}
      alt={d.hero.logoAlt}
      widths={[340, 680, 960]}
      sizes="(max-width: 600px) 72vw, 340px"
      format="webp"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="bar" aria-hidden="true"></div>
    <h1>{d.hero.title}</h1>
    <p class="tag">{d.hero.tag}</p>
    <p class="lead">{d.hero.lead}</p>
    <p class="motto">{d.hero.motto}</p>
    <div class="cta">
      <a class="btn p" href="#follow">{d.hero.ctaFollow}</a>
      <a class="btn" href={href(locale, '/about/')}>{d.hero.ctaAbout}</a>
    </div>
  </div>
</section>

<section class="sec" id="about">
  <div class="wrap">
    <div class="kicker reveal"><span class="num">{num('about')}</span><span class="lbl">{d.home.about.kicker}</span></div>
    <h2 class="reveal">{d.home.about.title}</h2>
    <p class="sub reveal">{d.home.about.sub}</p>
    <div class="grid c2">
      <div class="prose reveal">
        <p>{d.home.about.p1}</p>
        <p>{d.home.about.p2}</p>
        <a class="more" href={href(locale, '/about/')}>{d.home.about.more} <span aria-hidden="true">{d.arrow}</span></a>
      </div>
      <div class="reveal">
        <h3 class="hd" style="margin-top:0">{d.home.about.chipsTitle}</h3>
        <ul class="chips">
          {d.home.about.chips.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

{
  nextEvents.length > 0 && (
    <section class="sec" id="events">
      <div class="wrap">
        <div class="kicker reveal">
          <span class="num">{num('events')}</span>
          <span class="lbl">{d.home.events.kicker}</span>
        </div>
        <h2 class="reveal">{d.home.events.title}</h2>
        <p class="sub reveal">{d.home.events.sub}</p>
        <div class="grid c2 reveal">
          {nextEvents.map((e) => (
            <EventCard locale={locale} event={e} />
          ))}
        </div>
        <a class="more reveal" href={href(locale, '/events/')}>
          {d.home.events.all} <span aria-hidden="true">{d.arrow}</span>
        </a>
      </div>
    </section>
  )
}

{
  featured.length > 0 && (
    <section class="sec" id="projects">
      <div class="wrap">
        <div class="kicker reveal">
          <span class="num">{num('projects')}</span>
          <span class="lbl">{d.home.projects.kicker}</span>
        </div>
        <h2 class="reveal">{d.home.projects.title}</h2>
        <p class="sub reveal">{d.home.projects.sub}</p>
        <div class="grid c3 reveal">
          {featured.map((p) => (
            <ProjectCard locale={locale} project={p} />
          ))}
        </div>
        <a class="more reveal" href={href(locale, '/projects/')}>
          {d.home.projects.all} <span aria-hidden="true">{d.arrow}</span>
        </a>
      </div>
    </section>
  )
}

<section class="sec" id="offer">
  <div class="wrap">
    <div class="kicker reveal"><span class="num">{num('offer')}</span><span class="lbl">{d.home.offer.kicker}</span></div>
    <h2 class="reveal">{d.home.offer.title}</h2>
    <p class="sub reveal">{d.home.offer.sub}</p>
    <div class="grid c3 reveal">
      {
        tracks.map((tr) => (
          <div class="card">
            <span class="n">{tr.n}</span>
            <h3>{tr.title}</h3>
            <p>{tr.body}</p>
          </div>
        ))
      }
    </div>
    <a class="more reveal" href={href(locale, '/about/') + '#how'}>{d.home.offer.more} <span aria-hidden="true">{d.arrow}</span></a>
  </div>
</section>

<section class="sec" id="program">
  <div class="wrap">
    <div class="kicker reveal"><span class="num">{num('program')}</span><span class="lbl">{d.home.program.kicker}</span></div>
    <h2 class="reveal">{d.home.program.title}</h2>
    <p class="tag reveal" style="margin:0 0 10px">{d.home.program.tag}</p>
    <p class="sub reveal">{d.home.program.sub}</p>
    <div class="stats reveal">
      {
        d.camp.stats.map((s) => (
          <div class="stat">
            <b class:list={{ w: s.wide }}>{s.v}</b>
            <span>{s.l}</span>
          </div>
        ))
      }
    </div>
    <div class="prose mt reveal">
      <p>{d.home.program.body}</p>
    </div>
    <div class="cta reveal" style="justify-content:flex-start;margin-top:22px">
      <a class="btn p" href={href(locale, campPath)}>{d.home.program.cta}</a>
      <a class="btn" href={d.camp.site.url} target="_blank" rel="noopener">{d.camp.site.cta}</a>
    </div>
  </div>
</section>

{
  hasTeam && (
    <section class="sec" id="team">
      <div class="wrap">
        <div class="kicker reveal">
          <span class="num">{num('team')}</span>
          <span class="lbl">{d.home.team.kicker}</span>
        </div>
        <h2 class="reveal">{d.home.team.title}</h2>
        <p class="sub reveal">{d.home.team.sub}</p>

        {founders.length > 0 && (
          <>
            <h3 class="hd reveal" style="margin-top:0">
              {d.home.team.foundersTitle}
            </h3>
            <div class="grid people reveal">
              {founders.map((p) => (
                <PersonCard locale={locale} person={p} />
              ))}
            </div>
          </>
        )}

        {trainers.length > 0 && (
          <>
            <h3 class="hd reveal">{d.home.team.trainersTitle}</h3>
            <ul class="plist cols reveal">
              {trainers.map((p) => {
                const name = tx(p.data.name, locale);
                return (
                  <li>
                    <a href={href(locale, `/about/${p.id}/`)}>
                      <span class="ava" aria-hidden="true">
                        {p.data.photo ? <Image src={p.data.photo} alt="" width={72} height={72} format="webp" /> : initial(name)}
                      </span>
                      {name}
                    </a>
                  </li>
                );
              })}
            </ul>
          </>
        )}

        <a class="more reveal" href={href(locale, '/about/') + '#team'}>
          {d.home.team.all} <span aria-hidden="true">{d.arrow}</span>
        </a>
      </div>
    </section>
  )
}

{
  faq.length > 0 && (
    <section class="sec" id="faq">
      <div class="wrap">
        <div class="kicker reveal">
          <span class="num">{num('faq')}</span>
          <span class="lbl">{d.faq.kicker}</span>
        </div>
        <h2 class="reveal">{d.faq.homeTitle}</h2>
        <p class="sub reveal">{d.faq.homeSub}</p>
        <div class="reveal">
          <Faq items={faq} />
        </div>
        <a class="more reveal" href={href(locale, '/faq/')}>
          {d.faq.all} <span aria-hidden="true">{d.arrow}</span>
        </a>
      </div>
    </section>
  )
}

<section class="sec" id="invite">
  <div class="wrap">
    <div class="callout reveal">
      <h3>{d.home.invite.title}</h3>
      <p>{d.home.invite.body}</p>
      <div class="cta" style="justify-content:flex-start;margin-top:18px">
        <a class="btn p" href="#follow">{d.home.invite.cta}</a>
      </div>
    </div>
  </div>
</section>

<Follow locale={locale} />
