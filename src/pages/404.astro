---
import Base from '../layouts/Base.astro';
import { t, href } from '../i18n';

const d = t('ar');
const e = t('en');
---

<Base locale="ar" title={d.meta.notFound.title} description={d.meta.notFound.description} path="/" noindex>
  <section class="sec nf">
    <div class="wrap">
      <p class="code" aria-hidden="true">{d.notFound.code}</p>
      <h1 class="t">{d.notFound.title}</h1>
      <p class="sub" style="margin-inline:auto">{d.notFound.body}</p>
      <p class="sub" lang="en" dir="ltr" style="margin-inline:auto;font-family:'Sora',sans-serif;font-size:.95rem;color:var(--mist)">{e.notFound.title}. {e.notFound.body}</p>
      <div class="cta">
        <a class="btn p" href={href('ar', '/')}>{d.notFound.cta}</a>
        <a class="btn" href={href('en', '/')} lang="en">{e.notFound.cta}</a>
      </div>
    </div>
  </section>
</Base>
