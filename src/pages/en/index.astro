---
import Base from '../../layouts/Base.astro';
import Home from '../../components/pages/Home.astro';
import { t } from '../../i18n';

const locale = 'en' as const;
const d = t(locale);
---

<Base locale={locale} title={d.meta.home.title} description={d.meta.home.description} path="/">
  <Home locale={locale} />
</Base>
