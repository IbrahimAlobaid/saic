---
import Base from '../../../layouts/Base.astro';
import ProjectPage from '../../../components/pages/ProjectPage.astro';
import { t } from '../../../i18n';
import { tx, allProjects } from '../../../lib/content';

export async function getStaticPaths() {
  const projects = await allProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const locale = 'en' as const;
const d = t(locale);
const { project } = Astro.props;
const title = tx(project.data.title, locale);
const path = `/projects/${project.id}/`;
---

<Base
  locale={locale}
  title={`${title} | ${d.meta.siteName}`}
  description={tx(project.data.summary, locale)}
  path={path}
  crumbs={[
    { name: d.projects.kicker, path: '/projects/' },
    { name: title, path },
  ]}
>
  <ProjectPage locale={locale} project={project} />
</Base>
