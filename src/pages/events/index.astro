---
import Base from '../../layouts/Base.astro';
import EventsIndex from '../../components/pages/EventsIndex.astro';
import { t } from '../../i18n';

const locale = 'ar' as const;
const d = t(locale);
---

<Base locale={locale} title={d.meta.events.title} description={d.meta.events.description} path="/events/">
  <EventsIndex locale={locale} />
</Base>
