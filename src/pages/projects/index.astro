---
import Base from '../../layouts/Base.astro';
import ProjectsIndex from '../../components/pages/ProjectsIndex.astro';
import { t } from '../../i18n';
import { collectionHasFiles } from '../../lib/content';

const locale = 'ar' as const;
const d = t(locale);
---

<Base
  locale={locale}
  title={d.meta.projects.title}
  description={d.meta.projects.description}
  path="/projects/"
  pageType="CollectionPage"
  noindex={!collectionHasFiles('projects')}
  crumbs={[{ name: d.projects.kicker, path: '/projects/' }]}
>
  <ProjectsIndex locale={locale} />
</Base>
